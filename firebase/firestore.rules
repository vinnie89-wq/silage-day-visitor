rules_version = '2';

// =========================================================
// Who can do what – for BOTH the visitor app and the Team hub app.
// Paste this into: Firebase console → Firestore Database → Rules,
// put the organisers' Google email addresses in the list below,
// then press Publish.
//
//   pending/{id} – new photos waiting to be checked (small picture)
//   full/{id}    – the bigger picture for each photo
//   gallery/{id} – approved photos everyone can see
//   registrations/{code} – ticket pre-registrations (one per group)
//   checkins/{code}      – who in the group has paid at the gate
//   news/{id}            – news posts and urgent alerts
//   meetings, actions, teamDocs – the organisers' Team hub app (silage-day-team)
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ✏️ The organisers who can approve photos (their Google account emails)
    function isOrganiser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "pembs.silage.day@gmail.com"
        ];
    }

    // Any visitor (signed in anonymously by the app) can ADD a photo,
    // but can't read, change or delete anyone's – not even their own.
    function isNewPhoto() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(["thumb", "w", "h", "uid", "lang", "createdAt"])
        && d.uid == request.auth.uid
        && d.thumb is string && d.thumb.size() < 120000
        && d.thumb.matches("^data:image/jpeg;base64,.*")
        && d.createdAt == request.time;
    }

    match /pending/{id} {
      allow create: if isNewPhoto();
      allow read, delete: if isOrganiser();
    }

    match /full/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["image", "uid"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && !exists(/databases/$(database)/documents/full/$(id));
      // Big pictures can be seen once approved (or by organisers while checking)
      allow read: if isOrganiser() || exists(/databases/$(database)/documents/gallery/$(id));
      allow delete: if isOrganiser();
    }

    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if isOrganiser();
    }

    // ---------- Ticket pre-registrations ----------
    // One document per group, named by its 6-letter group code.
    // The phone that made it can see, change or cancel it; organisers
    // can see all of them (for the gate). Nobody else can see anything.
    function isValidRegistration(d) {
      return d.keys().hasOnly(["uid", "leadName", "email", "mobile", "members",
                               "agreed", "childrenAgreed", "signedName", "rulesVersion",
                               "lang", "news", "createdAt", "updatedAt"])
        && d.uid == request.auth.uid
        && d.leadName is string && d.leadName.size() >= 2 && d.leadName.size() <= 80
        && d.email is string && d.email.size() <= 120 && d.email.matches("^[^@ ]+@[^@ ]+[.][^@ ]+$")
        && d.mobile is string && d.mobile.size() <= 30
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 12
        && d.agreed == true && d.childrenAgreed is bool
        && d.signedName is string && d.signedName.size() >= 2 && d.signedName.size() <= 80
        && d.rulesVersion is int && d.lang in ["cy", "en"] && d.news is bool
        && d.updatedAt == request.time;
    }

    match /registrations/{code} {
      allow create: if request.auth != null
        && code.matches("^[A-Z2-9]{6}$")
        && isValidRegistration(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // (resource == null: lets a phone find out its group was cancelled)
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid || isOrganiser());
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && isValidRegistration(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid || isOrganiser());
    }

    // ---------- Who has paid at the gate ----------
    // One document per group (named by its group code) with a "paid"
    // list of person numbers, e.g. paid: [1, 3]. Only organisers (the
    // gate) can write it. A phone holding a ticket can look up ITS OWN
    // group's document by code (get), but nobody except organisers can
    // list them, so group codes can't be fished out.
    match /checkins/{code} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if isOrganiser();
    }

    // ---------- News and urgent alerts ----------
    // Everyone can read news (scheduled posts are only hidden by the app
    // until their time – don't schedule anything confidential).
    // Only organisers can write: from news-admin.html now, and later
    // from the organiser app using the same fields.
    function isValidNews(d) {
      return d.keys().hasOnly(["titleEn", "titleCy", "bodyEn", "bodyCy", "urgent",
                               "publishAt", "hideAt", "author", "createdAt", "updatedAt"])
        && d.titleEn is string && d.titleEn.size() <= 120
        && d.titleCy is string && d.titleCy.size() <= 120
        && (d.titleEn.size() > 0 || d.titleCy.size() > 0)
        && d.bodyEn is string && d.bodyEn.size() <= 2000
        && d.bodyCy is string && d.bodyCy.size() <= 2000
        && d.urgent is bool
        && d.publishAt is timestamp
        && (d.hideAt == null || d.hideAt is timestamp)
        && d.updatedAt == request.time;
    }

    match /news/{id} {
      allow read: if true;
      allow create, update: if isOrganiser() && isValidNews(request.resource.data);
      allow delete: if isOrganiser();
    }

    // ---------- Team hub (organisers only) ----------
    // The separate Team hub app (silage-day-team): meetings, the shared
    // action tracker and the list of document links.
    match /meetings/{id} {
      allow read, write: if isOrganiser();
    }
    match /actions/{id} {
      allow read, delete: if isOrganiser();
      allow create, update: if isOrganiser()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
    }
    match /teamDocs/{id} {
      allow read, write: if isOrganiser();
    }

    // ---------- Settings the organisers control (e.g. ticket prices) ----------
    // config/prices: adult, child (numbers, £), show (true = visitors see them).
    // Everyone can read; only organisers can change (from the Team hub).
    match /config/{id} {
      allow read: if true;
      allow write: if isOrganiser()
        && (id != "prices" || (request.resource.data.adult is number && request.resource.data.adult >= 0
                               && request.resource.data.child is number && request.resource.data.child >= 0
                               && request.resource.data.show is bool));
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
